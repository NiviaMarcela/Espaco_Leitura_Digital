# Copie este arquivo para .env e configure os dados LOCALMENTE.
# O banco deve existir antes de executar db:migrate.
PGHOST=localhost
PGPORT=5432
PGDATABASE=espaco_leitura
PGUSER=biblioteca
PGPASSWORD="SUA_SENHA"
# Alternativa para bancos hospedados: DATABASE_URL (tem prioridade sobre PG*).
PORT=3001
# Configure these once to create the first administrator. Use a unique, strong
# password of at least 12 characters. They are not used to reset an existing admin.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
