<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_EspacoLeitura"
                  targetNamespace="https://espaco-leitura.local/bpmn">
  <bpmn:collaboration id="Collaboration_EspacoLeitura">
    <bpmn:participant id="Participant_EspacoLeitura" name="Espaço de Leitura Digital" processRef="Process_EspacoLeitura"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_EspacoLeitura" name="Fluxo geral do sistema" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EspacoLeitura">
      <bpmn:lane id="Lane_Pessoa" name="Pessoa usuária / equipe">
        <bpmn:flowNodeRef>Start_Acesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbrirPortal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CatalogoPublico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Publico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecuperarAcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrocarSenhaForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultarBiblioteca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcoesLeitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmarRetirada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OperarModulos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OperacoesRestritas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Leitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Equipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Responsavel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ interface" name="Interface web">
        <bpmn:flowNodeRef>Task_MostrarPortal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Intencao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CadastroConcluido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespostaGenerica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ErroLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SenhaTemporaria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Retirada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Responsavel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recuperacao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_API" name="API Express e regras de negócio">
        <bpmn:flowNodeRef>Task_ValidarCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarRecuperacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Autenticar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Credenciais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriarSessao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AlterarSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarReserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LiberarReserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriarEmprestimo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Banco" name="PostgreSQL">
        <bpmn:flowNodeRef>Task_GravarCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GravarRecuperacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GravarSessao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GravarSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GravarReserva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GravarEmprestimo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Acesso" name="Início">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_AbrirPortal" name="Acessar o portal">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MostrarPortal" name="Exibir início e catálogo público">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Intencao" name="O que deseja fazer?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CatalogoPublico" name="Consultar destaques e catálogo público">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Publico" name="Consulta pública concluída">
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Cadastro" name="Preencher cadastro de leitor">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ValidarCadastro" name="Validar dados e criar conta de leitor">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08A</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarCadastro" name="Gravar conta e credenciais">
      <bpmn:incoming>Flow_08A</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CadastroConcluido" name="Informar que já pode entrar">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RecuperarAcesso" name="Solicitar ajuda para recuperar acesso">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RegistrarRecuperacao" name="Registrar pedido elegível; não alterar senha">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_11A</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarRecuperacao" name="Manter solicitação pendente">
      <bpmn:incoming>Flow_11A</bpmn:incoming>
      <bpmn:outgoing>Flow_11B</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RespostaGenerica" name="Exibir orientação genérica; equipe não envia e-mail">
      <bpmn:incoming>Flow_11B</bpmn:incoming>
      <bpmn:outgoing>Flow_11C</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Recuperacao" name="Aguardar atendimento assistido">
      <bpmn:incoming>Flow_11C</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Login" name="Informar e-mail e senha">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Autenticar" name="Autenticar e validar sessão">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Credenciais" name="Credenciais válidas?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ErroLogin" name="Informar falha e permitir nova tentativa">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CriarSessao" name="Criar sessão autenticada e cookie seguro">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarSessao" name="Armazenar sessão">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SenhaTemporaria" name="Senha temporária exige troca?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TrocarSenhaForm" name="Informar senha atual e nova senha">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AlterarSenha" name="Validar e atualizar senha; encerrar sessões antigas">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_21A</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarSenha" name="Persistir hash da senha">
      <bpmn:incoming>Flow_21A</bpmn:incoming>
      <bpmn:outgoing>Flow_21B</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Perfil" name="Direcionar conforme perfil e Centro" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_21B</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ConsultarBiblioteca" name="Abrir biblioteca do próprio Centro">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AcoesLeitor" name="Consultar acervo, acompanhar empréstimos e criar/cancelar reserva">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Reserva" name="Criar reserva?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Leitor" name="Acompanhar conta ou sair">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ValidarReserva" name="Validar cópia, leitor e limite; marcar reserva pendente">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarReserva" name="Gravar reserva e status do exemplar">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Retirada" name="Reserva cancelada/expirada ou retirada confirmada?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_LiberarReserva" name="Cancelar/expirar: liberar exemplar e vaga">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmarRetirada" name="Equipe autorizada confirma a entrega da cópia">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CriarEmprestimo" name="Iniciar empréstimo com prazo de 30 dias">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GravarEmprestimo" name="Gravar empréstimo e exemplar emprestado">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OperarModulos" name="Equipe: acervo, categorias, leitores; empréstimos diretos, renovação, devolução, reservas e relatórios/dashboard">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Responsavel" name="Admin/coordenador?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OperacoesRestritas" name="Admin/coordenador: gerir usuários e recuperação assistida; Livro Vivo (doação e retorno parcial)">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Equipe" name="Encerrar sessão da equipe">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:incoming>Flow_36</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Acesso" targetRef="Task_AbrirPortal"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AbrirPortal" targetRef="Task_MostrarPortal"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_MostrarPortal" targetRef="Gateway_Intencao"/>
    <bpmn:sequenceFlow id="Flow_04" name="Visitar catálogo" sourceRef="Gateway_Intencao" targetRef="Task_CatalogoPublico"/>
    <bpmn:sequenceFlow id="Flow_05" name="Criar conta" sourceRef="Gateway_Intencao" targetRef="Task_Cadastro"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CatalogoPublico" targetRef="End_Publico"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Cadastro" targetRef="Task_ValidarCadastro"/>
    <bpmn:sequenceFlow id="Flow_08A" sourceRef="Task_ValidarCadastro" targetRef="Task_GravarCadastro"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_GravarCadastro" targetRef="Task_CadastroConcluido"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CadastroConcluido" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_08" name="Recuperar acesso" sourceRef="Gateway_Intencao" targetRef="Task_RecuperarAcesso"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RecuperarAcesso" targetRef="Task_RegistrarRecuperacao"/>
    <bpmn:sequenceFlow id="Flow_11A" sourceRef="Task_RegistrarRecuperacao" targetRef="Task_GravarRecuperacao"/>
    <bpmn:sequenceFlow id="Flow_11B" sourceRef="Task_GravarRecuperacao" targetRef="Task_RespostaGenerica"/>
    <bpmn:sequenceFlow id="Flow_11C" sourceRef="Task_RespostaGenerica" targetRef="End_Recuperacao"/>
    <bpmn:sequenceFlow id="Flow_12" name="Entrar" sourceRef="Gateway_Intencao" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Login" targetRef="Task_Autenticar"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Autenticar" targetRef="Gateway_Credenciais"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ErroLogin" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_16" name="Não" sourceRef="Gateway_Credenciais" targetRef="Task_ErroLogin"/>
    <bpmn:sequenceFlow id="Flow_17" name="Sim" sourceRef="Gateway_Credenciais" targetRef="Task_CriarSessao"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CriarSessao" targetRef="Task_GravarSessao"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_GravarSessao" targetRef="Gateway_SenhaTemporaria"/>
    <bpmn:sequenceFlow id="Flow_20" name="Sim" sourceRef="Gateway_SenhaTemporaria" targetRef="Task_TrocarSenhaForm"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_TrocarSenhaForm" targetRef="Task_AlterarSenha"/>
    <bpmn:sequenceFlow id="Flow_21A" sourceRef="Task_AlterarSenha" targetRef="Task_GravarSenha"/>
    <bpmn:sequenceFlow id="Flow_21B" sourceRef="Task_GravarSenha" targetRef="Gateway_Perfil"/>
    <bpmn:sequenceFlow id="Flow_22" name="Não" sourceRef="Gateway_SenhaTemporaria" targetRef="Gateway_Perfil"/>
    <bpmn:sequenceFlow id="Flow_23" name="Leitor" sourceRef="Gateway_Perfil" targetRef="Task_ConsultarBiblioteca"/>
    <bpmn:sequenceFlow id="Flow_24" name="Admin, coordenador, professor ou funcionário" sourceRef="Gateway_Perfil" targetRef="Task_OperarModulos"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConsultarBiblioteca" targetRef="Task_AcoesLeitor"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_AcoesLeitor" targetRef="Gateway_Reserva"/>
    <bpmn:sequenceFlow id="Flow_27" name="Sim" sourceRef="Gateway_Reserva" targetRef="Task_ValidarReserva"/>
    <bpmn:sequenceFlow id="Flow_28" name="Não; apenas consultar/acompanhar" sourceRef="Gateway_Reserva" targetRef="End_Leitor"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ValidarReserva" targetRef="Task_GravarReserva"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_GravarReserva" targetRef="Gateway_Retirada"/>
    <bpmn:sequenceFlow id="Flow_31" name="Cancelar ou expirar" sourceRef="Gateway_Retirada" targetRef="Task_LiberarReserva"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_LiberarReserva" targetRef="End_Leitor"/>
    <bpmn:sequenceFlow id="Flow_33" name="Retirada confirmada" sourceRef="Gateway_Retirada" targetRef="Task_ConfirmarRetirada"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ConfirmarRetirada" targetRef="Task_CriarEmprestimo"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_CriarEmprestimo" targetRef="Task_GravarEmprestimo"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_GravarEmprestimo" targetRef="End_Equipe"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_OperarModulos" targetRef="Gateway_Responsavel"/>
    <bpmn:sequenceFlow id="Flow_38" name="Sim" sourceRef="Gateway_Responsavel" targetRef="Task_OperacoesRestritas"/>
    <bpmn:sequenceFlow id="Flow_39" name="Não" sourceRef="Gateway_Responsavel" targetRef="End_Equipe"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_OperacoesRestritas" targetRef="End_Responsavel"/>
    <bpmn:endEvent id="End_Responsavel" name="Encerrar sessão do responsável">
      <bpmn:incoming>Flow_40</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_EspacoLeitura">
    <bpmndi:BPMNPlane id="Plane_EspacoLeitura" bpmnElement="Collaboration_EspacoLeitura">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_EspacoLeitura" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="3700" height="800"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Pessoa" bpmnElement="Lane_Pessoa" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="3670" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Interface" bpmnElement="Lane_ interface" isHorizontal="true">
        <dc:Bounds x="50" y="210" width="3670" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_API" bpmnElement="Lane_API" isHorizontal="true">
        <dc:Bounds x="50" y="400" width="3670" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Banco" bpmnElement="Lane_Banco" isHorizontal="true">
        <dc:Bounds x="50" y="600" width="3670" height="200"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Acesso" bpmnElement="Start_Acesso"><dc:Bounds x="90" y="90" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AbrirPortal" bpmnElement="Task_AbrirPortal"><dc:Bounds x="150" y="78" width="130" height="60"/></bpmndi:BPMNShape>
